    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/server/**/*.ts", "src/application/**/*.ts", "src/domain/**/*.ts", "src/persistence/**/*.ts"]
}
